generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  SELLER
  MECHANIC
}

model User {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  // The migration also enforces lowercase, nonempty usernames without outer whitespace.
  username           String                    @unique
  phone              String?
  email              String?
  role               Role
  active             Boolean                   @default(true)
  passwordHash       String
  mustChangePassword Boolean                   @default(false)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  recoveryRequests   PasswordRecoveryRequest[] @relation("RecoverySubject")
  resolvedRecoveries PasswordRecoveryRequest[] @relation("RecoveryResolver")
  historyEvents      HistoryEvent[]
  confirmedInvoices  Invoice[]                 @relation("InvoiceConfirmedBy")
  cancelledInvoices  Invoice[]                 @relation("InvoiceCancelledBy")
  issuedQuotes            Invoice[]                 @relation("InvoiceQuoteIssuedBy")
  invoicePayments         InvoicePayment[]
  assistantConversations  AssistantConversation[]
}

enum HistoryActorType {
  USER
  ANONYMOUS
  SYSTEM
}

model HistoryEvent {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt  DateTime         @default(now()) @db.Timestamptz(3)
  actorType   HistoryActorType
  actorUserId String?          @db.Uuid
  eventType   String
  subjectType String
  subjectId   String           @db.Uuid
  payload     Json             @db.JsonB
  actor       User?            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId, occurredAt, id])
  @@index([actorUserId, occurredAt])
}

enum RecoveryStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

model PasswordRecoveryRequest {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @db.Uuid
  status           RecoveryStatus @default(PENDING)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime       @db.Timestamptz(3)
  resolvedAt       DateTime?      @db.Timestamptz(3)
  resolvedById     String?        @db.Uuid
  identityVerified Boolean        @default(false)
  user             User           @relation("RecoverySubject", fields: [userId], references: [id], onDelete: Restrict)
  resolvedBy       User?          @relation("RecoveryResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([userId])
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

enum CustomerType {
  CASH
  CREDIT
}

model Customer {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  rnc             String?           @unique
  address         String?
  notes           String?
  isDefault       Boolean           @default(false)
  customerType    CustomerType      @default(CASH)
  creditLimitDop  Decimal?          @db.Decimal(12, 2)
  creditTermDays  Int?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  contacts        CustomerContact[]
  invoices        Invoice[]

  @@index([name])
  @@index([customerType])
  // Customer_credit_terms_check is defined in SQL.
}

model CustomerContact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @db.Uuid
  name       String?
  phone      String?
  email      String?
  title      String?
  isPrimary  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model MechanicalService {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  description  String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  invoiceLines InvoiceLine[]

  @@index([active, name])
}

enum InvoiceStatus {
  DRAFT
  QUOTE_DRAFT
  QUOTE_ISSUED
  CONDUCE
  COMPLETED
  CANCELLED
}

enum InvoiceCurrency {
  DOP
  USD
}

enum InvoiceLineType {
  GENERIC
  SERVICE
  DELIVERY
  EXTERNAL
  ITEM
  QTY
}

enum CostProvenance {
  ACTUAL
  ESTIMATED
  UNKNOWN
}

enum InvoicePdfStatus {
  READY
  FAILED
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
}

model Invoice {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status       InvoiceStatus
  currency     InvoiceCurrency
  fiscal       Boolean
  applyItbis   Boolean         @default(false)
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)
  customerId   String          @db.Uuid
  number       String?         @unique
  quoteNumber  String?         @unique
  quoteIssuedAt DateTime?      @db.Timestamptz(3)
  quoteExpiresAt DateTime?     @db.Timestamptz(3)
  quoteIssuedByUserId String?  @db.Uuid
  quoteIssuedByName   String?
  conduceNumber   String?      @unique
  conduceIssuedAt DateTime?    @db.Timestamptz(3)
  invoiceIssuedAt DateTime?    @db.Timestamptz(3)
  confirmedAt  DateTime?       @db.Timestamptz(3)
  dueDate      DateTime?       @db.Date
  customerName String?
  customerRnc  String?
  customerPhone String?
  snapshotCustomerType   CustomerType?
  snapshotCreditTermDays Int?
  confirmedByUserId String?     @db.Uuid
  confirmedByName   String?
  cancelledAt       DateTime?   @db.Timestamptz(3)
  cancelReason      String?
  cancelledByUserId String?     @db.Uuid
  cancelledByName   String?
  cancellationIdempotencyKey String? @db.VarChar(100)
  gross        Decimal?        @db.Decimal(12, 2)
  base         Decimal?        @db.Decimal(12, 2)
  itbis        Decimal?        @db.Decimal(12, 2)
  manualGrossProfitDop Decimal?  @db.Decimal(12, 2)
  manualGrossProfitAt  DateTime? @db.Timestamptz(3)
  exchangeRateDopPerUsd Decimal?  @db.Decimal(18, 8)
  fxRateSource          String?
  fxRateUpdatedAt       DateTime? @db.Timestamptz(3)
  fxRateObtainedAt      DateTime? @db.Timestamptz(3)
  pdfStatus             InvoicePdfStatus?
  pdfErrorId            String?           @db.Uuid
  pdfGeneratedAt        DateTime?         @db.Timestamptz(3)
  pdfTemplateVersion    String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteIssuedBy User?          @relation("InvoiceQuoteIssuedBy", fields: [quoteIssuedByUserId], references: [id], onDelete: Restrict)
  confirmedBy  User?           @relation("InvoiceConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  cancelledBy  User?           @relation("InvoiceCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  lines        InvoiceLine[]
  payments     InvoicePayment[]

  @@index([customerId])
  @@index([customerId, status, currency])
  @@index([quoteIssuedByUserId])
  @@index([confirmedByUserId])
  @@index([cancelledByUserId])
  @@index([dueDate])
  @@index([quoteExpiresAt])
  @@index([status, confirmedAt])
  // Invoice_number_status_check quote/conduce/snapshot branches and
  // Invoice_recognized_customer_currency_idx are defined in SQL.
}

model InvoicePayment {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId      String          @db.Uuid
  kind           PaymentKind
  amount         Decimal         @db.Decimal(12, 2)
  currency       InvoiceCurrency
  method         PaymentMethod
  effectiveDate  DateTime        @db.Date
  reference      String?
  actorUserId    String          @db.Uuid
  idempotencyKey String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  actor          User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, idempotencyKey])
  @@index([invoiceId, effectiveDate, createdAt])
  @@index([actorUserId])
}

model InvoiceLine {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId          String             @db.Uuid
  type               InvoiceLineType
  description        String
  notes              String?
  quantity           Decimal            @default(1) @db.Decimal(12, 2)
  unitPrice          Decimal            @db.Decimal(12, 2)
  acquisitionCostDop Decimal?           @db.Decimal(12, 2)
  costProvenance     CostProvenance?
  serviceId          String?            @db.Uuid
  gross              Decimal?           @db.Decimal(12, 2)
  base               Decimal?           @db.Decimal(12, 2)
  itbis              Decimal?           @db.Decimal(12, 2)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  invoice            Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service            MechanicalService? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([serviceId])
  // Partial unique InvoiceLine_one_delivery_per_invoice is defined in SQL.
}

model InvoiceSequence {
  name      String @id
  nextValue Int
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

enum AssistantMessageStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum AssistantRunStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum AssistantSourceType {
  DOCUMENT
  TOOL
}

enum AssistantKnowledgeStatus {
  SYNC_PENDING
  INDEXING
  READY
  FAILED
  REMOVED
}

model AssistantConversation {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String             @db.Uuid
  title         String             @default("")
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  lastMessageAt DateTime           @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime           @db.Timestamptz(3)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AssistantMessage[]
  runs          AssistantRun[]

  @@index([userId, lastMessageAt])
  @@index([expiresAt])
}

model AssistantMessage {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String                 @db.Uuid
  role            AssistantMessageRole
  status          AssistantMessageStatus
  content         String
  clientRequestId String?
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?              @db.Timestamptz(3)
  conversation    AssistantConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userRun         AssistantRun?          @relation("AssistantRunUserMessage")
  assistantRun    AssistantRun?          @relation("AssistantRunAssistantMessage")
  sources         AssistantSource[]

  @@unique([conversationId, clientRequestId])
  @@index([conversationId, createdAt, id])
}

model AssistantRun {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId     String                @db.Uuid
  userMessageId      String                @unique @db.Uuid
  assistantMessageId String?               @unique @db.Uuid
  status             AssistantRunStatus
  model              String
  promptVersion      String
  providerResponseId String?
  inputTokens        Int?
  outputTokens       Int?
  toolCallCount      Int                   @default(0)
  toolCalls          Json?
  startedAt          DateTime              @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?             @db.Timestamptz(3)
  latencyMs          Int?
  errorCode          String?
  errorId            String?
  conversation       AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userMessage        AssistantMessage      @relation("AssistantRunUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)
  assistantMessage   AssistantMessage?     @relation("AssistantRunAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull)

  @@index([conversationId, startedAt])
  // AssistantRun_one_pending_per_conversation is defined in SQL.
}

model AssistantSource {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assistantMessageId String             @db.Uuid
  type              AssistantSourceType
  sourceKey         String
  title             String
  locator           String?
  sortOrder         Int
  appPath           String?
  excerpt           String?
  score             Float?
  asOf              DateTime?           @db.Timestamptz(3)
  message           AssistantMessage    @relation(fields: [assistantMessageId], references: [id], onDelete: Cascade)

  @@index([assistantMessageId, sortOrder])
}

model AssistantKnowledgeDocument {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceKey       String                   @unique
  title           String
  version         String
  contentSha256   String
  status          AssistantKnowledgeStatus @default(SYNC_PENDING)
  providerFileId  String?
  approvedAt      DateTime?                @db.Timestamptz(3)
  indexedAt       DateTime?                @db.Timestamptz(3)
  lastSyncedAt    DateTime?                @db.Timestamptz(3)
  metadata        Json?
  errorCode       String?
  errorId         String?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([status])
}
