# Local development — copy to .env and fill in values. Never commit .env.

# API
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Assigned to administrator-created accounts. Users must change it on first login.
INITIAL_PASSWORD=your_initial_password

# Honor one X-Forwarded-For hop. Set to 1 only when the API is reached solely via
# the unpublished nginx container (docker compose). Leave 0 for a host-bound API.
TRUST_PROXY=0

# USD profitability (COST-003). Never commit the real key. Tests use a double.
# docker compose interpolates this into the api service from the host .env.
EXCHANGE_RATE_API_KEY=

# Feature 17 AI Assistant (post-stabilization pilot). Keep disabled until M9 evaluation.
# Missing OPENAI_* credentials are fine while ASSISTANT_ENABLED=false; invalid numeric
# ranges always fail boot. Never expose these to the frontend.
# `npm run assistant:sync-knowledge` needs OPENAI_API_KEY + OPENAI_VECTOR_STORE_ID even
# while ASSISTANT_ENABLED=false (one vector store per environment).
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_VECTOR_STORE_ID=
ASSISTANT_RETENTION_DAYS=90
ASSISTANT_DAILY_MESSAGE_LIMIT=50
ASSISTANT_MAX_INPUT_CHARS=2000
ASSISTANT_MAX_OUTPUT_TOKENS=1200
ASSISTANT_MAX_TOOL_CALLS=3
ASSISTANT_MAX_RETRIEVAL_RESULTS=6
ASSISTANT_RETRIEVAL_SCORE_THRESHOLD=0.55
ASSISTANT_REQUEST_TIMEOUT_MS=45000

# Database (PostgreSQL local)
# Create the database first, for example:
#   createdb truck_parts_dev
# or via psql:
#   CREATE DATABASE truck_parts_dev;
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/truck_parts_dev
#Test database
DATABASE_URL_TEST=postgresql://postgres:YOUR_PASSWORD@localhost:5433/truck_parts_test

DATABASE_URL_DOCKER=postgresql://postgres:YOUR_PASSWORD@db:5432/truck_parts_dev #Docker compose


DATABASE_USER= postgres
DATABASE_PASSWORD= YOUR_PASSWORD
DATABASE_NAME= truck_parts_dev
DATABASE_PORT= 5433

# Web Port for local development
WEB_PORT=5173  


# Frontend — Release 1 Access/Users HTTP (M10–M11)

# false uses the local API for auth, profile, users and password recovery.
# true restores the full in-memory prototype. Tests select mocks independently of .env.
VITE_USE_MOCK_API=false


# Values: prototype (default demo UI), release-1 … release-8
# HTTP mode limits visibility to Release 1 Access/Users, regardless of this preset.
VITE_CAPABILITIES_PRESET= release-2




# Optional: show reset/scenario controls outside Vite DEV
VITE_ENABLE_DEMO_CONTROLS=false


