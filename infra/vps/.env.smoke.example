# Example values for local smoke of infra/vps/compose.yaml (M2/M3).
# Copy to a gitignored file (e.g. infra/vps/.env.smoke) and fill secrets locally.
# Production/staging secrets live only on the VPS: /etc/solocamiones/<env>.env

COMPOSE_PROJECT_NAME=solocamiones_smoke
PUBLIC_HOSTNAME=localhost

# Generated by scripts/deployment/generate-dev-origin-certs.sh
ORIGIN_TLS_CERT=./certs/dev/origin.pem
ORIGIN_TLS_KEY=./certs/dev/origin.key
ORIGIN_CLIENT_CA=./certs/dev/aop-ca.pem

APP_ENV=staging
APP_RELEASE=v2.0.0
ALLOWED_HOSTS=localhost
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=smoke-audience-not-for-production
METRICS_BEARER_TOKEN=smoke-metrics-token-change-me
INITIAL_PASSWORD=SmokeInitialPassword1!
LOG_LEVEL=info
ASSISTANT_ENABLED=false
ASSISTANT_RETENTION_DAYS=90

POSTGRES_USER=solocamiones
POSTGRES_PASSWORD=smoke-db-password-change-me
POSTGRES_DB=solocamiones
POSTGRES_VOLUME_NAME=solocamiones_smoke_pgdata

# Least-privilege DB roles (M3.1). Passwords must differ from POSTGRES_PASSWORD.
ROLE_MIGRATION_PASSWORD=smoke-migration-password-change-me
ROLE_RUNTIME_PASSWORD=smoke-runtime-password-change-me
ROLE_BACKUP_PASSWORD=smoke-backup-password-change-me
ROLE_MONITORING_PASSWORD=smoke-monitoring-password-change-me
# Optional once on volumes where app tables were created by POSTGRES_USER before role split.
# Prefer empty on fresh installs (migrate as migration role). When set, only public schema
# objects are reassigned — never database-system ownership.
# BOOTSTRAP_REASSIGN_FROM=solocamiones

DATABASE_URL=postgresql://runtime:smoke-runtime-password-change-me@db:5432/solocamiones
DATABASE_MIGRATION_URL=postgresql://migration:smoke-migration-password-change-me@db:5432/solocamiones
BACKUP_DATABASE_URL=postgresql://backup:smoke-backup-password-change-me@db:5432/solocamiones

# Dedicated restore database (create manually before verify-restore). Never equal to DATABASE_URL.
RESTORE_DATABASE_URL=postgresql://migration:smoke-migration-password-change-me@db:5432/solocamiones_restore
# CONFIRM_RESTORE=yes
# BACKUP_OBJECT_KEY=hourly/staging/2026-10-02/20261002T030000.dump.age
# BACKUP_AGE_SECRET_KEY=AGE-SECRET-KEY-1...

# Cloudflare R2 (real staging bucket for M3.6). Never commit real keys.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=solocamiones-staging-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# age recipient public key only for backup jobs (private key stays in password manager).
BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: pin digests once GHCR publishes (M5). Empty uses local build tags.
# API_IMAGE=ghcr.io/owner/solocamiones-api@sha256:...
# WEB_IMAGE=ghcr.io/owner/solocamiones-web@sha256:...
# BACKUP_IMAGE=solocamiones-backup:local
