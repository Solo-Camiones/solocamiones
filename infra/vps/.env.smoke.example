# Example values for local smoke of infra/vps/compose.yaml.
# Copy to a gitignored file (e.g. infra/vps/.env.smoke) and fill secrets locally.
# Production/staging secrets live only on the VPS: /etc/solocamiones/<env>.env

COMPOSE_PROJECT_NAME=solocamiones_smoke
PUBLIC_HOSTNAME=localhost

# Generated by scripts/deployment/generate-dev-origin-certs.sh
ORIGIN_TLS_CERT=./certs/dev/origin.pem
ORIGIN_TLS_KEY=./certs/dev/origin.key
ORIGIN_CLIENT_CA=./certs/dev/aop-ca.pem

APP_ENV=staging
APP_RELEASE=v2.0.0
ALLOWED_HOSTS=localhost
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=smoke-audience-not-for-production
METRICS_BEARER_TOKEN=smoke-metrics-token-change-me
INITIAL_PASSWORD=SmokeInitialPassword1!
LOG_LEVEL=info
ASSISTANT_ENABLED=false

POSTGRES_USER=solocamiones
POSTGRES_PASSWORD=smoke-db-password-change-me
POSTGRES_DB=solocamiones
POSTGRES_VOLUME_NAME=solocamiones_smoke_pgdata

DATABASE_URL=postgresql://solocamiones:smoke-db-password-change-me@db:5432/solocamiones
DATABASE_MIGRATION_URL=postgresql://solocamiones:smoke-db-password-change-me@db:5432/solocamiones

# Optional: pin digests once GHCR publishes (M5). Empty uses local build tags.
# API_IMAGE=ghcr.io/owner/solocamiones-api@sha256:...
# WEB_IMAGE=ghcr.io/owner/solocamiones-web@sha256:...
