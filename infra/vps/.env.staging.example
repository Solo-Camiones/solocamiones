# Example staging environment file for /etc/solocamiones/staging.env (M6.4).
# Copy to the host as root, fill secrets from the password manager, then:
#   chown root:root /etc/solocamiones/staging.env
#   chmod 0600 /etc/solocamiones/staging.env
#
# NEVER commit a filled copy. NEVER put secrets in GitHub Issues/PRs/chat.
# Full variable reference: infra/vps/docs/STAGING_PROVISIONING.md §10
#
# Paths assume the host layout from sync-host-tree.sh:
#   /opt/solocamiones/infra/vps/compose.yaml
# Origin TLS files are host paths mounted into the edge container.

# --- Compose / public hostname ---
COMPOSE_PROJECT_NAME=solocamiones_staging
PUBLIC_HOSTNAME=staging.solocamiones.com

# Host-only (deploy.sh staging smoke). Compose services ignore these.
# Precedence for base URL: process env → this file → https://staging.solocamiones.com
SMOKE_BASE_URL=https://staging.solocamiones.com
# Cloudflare Access service token for machine smoke on the host (CF-Access-Client-*).
# Same token type is used by Better Stack uptime monitors. Not a GitHub Actions secret.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Origin TLS (edge mounts these host paths) ---
ORIGIN_TLS_CERT=/etc/solocamiones/certs/origin.pem
ORIGIN_TLS_KEY=/etc/solocamiones/certs/origin.key
ORIGIN_CLIENT_CA=/etc/solocamiones/certs/authenticated_origin_pull_ca.pem

# --- API runtime ---
APP_ENV=staging
NODE_ENV=production
APP_RELEASE=v2.0.0
ALLOWED_HOSTS=staging.solocamiones.com
TRUST_PROXY=1
LOG_LEVEL=info

# Cloudflare Access JWT validation (human WARP + service tokens). Audience ≠ production.
CF_ACCESS_TEAM_DOMAIN=YOUR_TEAM.cloudflareaccess.com
CF_ACCESS_AUD=REPLACE_WITH_STAGING_AUD

# Bearer for GET /metrics (Prometheus scrape). Not the Better Stack log token.
METRICS_BEARER_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
# Temporary password assigned when an Administrator creates users via UI (not bootstrap CLI).
INITIAL_PASSWORD=REPLACE_WITH_STAGING_INITIAL_PASSWORD

# Optional FX provider (commercial smoke may need it).
# EXCHANGE_RATE_API_KEY=

# Assistant — enable only after corpus sync (M6.7). Start false for first boot if preferred.
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_VECTOR_STORE_ID=
ASSISTANT_RETENTION_DAYS=90

# Observability binds: prefer Tailscale IP on the host; never 0.0.0.0 for exporters.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=http://127.0.0.1:3001
MONITORING_BIND=127.0.0.1
EXPORTER_BIND=127.0.0.1
METRICS_SCRAPE_BIND=127.0.0.1
# Production scrape from staging Prometheus (leave empty until production exists).
PRODUCTION_TAILSCALE_HOST=
PRODUCTION_METRICS_BEARER_TOKEN=

# Better Stack LOGS only (Vector profile `logs`). Uptime monitors use Access service token headers instead.
# Source token + Ingesting host from the same Logs source in Better Stack UI (not Uptime, not CF Access).
# Host only — no https://. curl probe that returns 202 confirms both values.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=sXXXXXX.REGION.betterstackdata.com

# PostgreSQL superuser (bootstrap only) + app DB name.
POSTGRES_USER=solocamiones
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_SUPERUSER_PASSWORD
POSTGRES_DB=solocamiones
POSTGRES_VOLUME_NAME=solocamiones_staging_pgdata

# Least-privilege roles (must differ from POSTGRES_PASSWORD and from each other).
# ROLE_*_PASSWORD values are used as-is by bootstrap-db (not URL-parsed).
ROLE_MIGRATION_PASSWORD=REPLACE_WITH_MIGRATION_PASSWORD
ROLE_RUNTIME_PASSWORD=REPLACE_WITH_RUNTIME_PASSWORD
ROLE_BACKUP_PASSWORD=REPLACE_WITH_BACKUP_PASSWORD
ROLE_MONITORING_PASSWORD=REPLACE_WITH_MONITORING_PASSWORD

# Prisma/libpq connection URLs — percent-encode userinfo special characters.
# Unescaped # ? / : @ [ ] % & = + in the password cause Prisma P1013
# ("invalid port number in database URL") even when bootstrap-db succeeded.
# Encode password only, e.g.:
#   python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=""))' 'RAW_PASSWORD'
# Example: password p#ss@1 → p%23ss%401 in the URL below (ROLE_* stays raw).
DATABASE_URL=postgresql://runtime:REPLACE_WITH_URL_ENCODED_RUNTIME_PASSWORD@db:5432/solocamiones
DATABASE_MIGRATION_URL=postgresql://migration:REPLACE_WITH_URL_ENCODED_MIGRATION_PASSWORD@db:5432/solocamiones
BACKUP_DATABASE_URL=postgresql://backup:REPLACE_WITH_URL_ENCODED_BACKUP_PASSWORD@db:5432/solocamiones

# Restore drill only (never equal to DATABASE_URL). Create DB before verify-restore.
RESTORE_DATABASE_URL=postgresql://migration:REPLACE_WITH_URL_ENCODED_MIGRATION_PASSWORD@db:5432/solocamiones_restore

# Cloudflare R2 staging bucket (already created for this environment).
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=solocamiones-staging-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public age recipient only (private key stays in password manager).
BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Immutable images — MANUAL after every successful deploy (deploy.sh does not write this file).
# Procedure: infra/vps/docs/STAGING_PROVISIONING.md §9.2
#   cat "$(ls -t /tmp/solocamiones-deploy-evidence/deploy-staging-*.txt | head -n1)"
#   ( /tmp is ephemeral; if missing, see §9.2 fallback with docker inspect )
# Then sudoedit this file: API_IMAGE / WEB_IMAGE / BACKUP_IMAGE from api_image / web_image / backup_image.
# Without these, `docker compose ... up` falls back to *:local and tries to build /opt/solocamiones/apps.
# API_IMAGE=ghcr.io/OWNER/solocamiones-api@sha256:...
# WEB_IMAGE=ghcr.io/OWNER/solocamiones-web@sha256:...
# BACKUP_IMAGE=ghcr.io/OWNER/solocamiones-backup@sha256:...
