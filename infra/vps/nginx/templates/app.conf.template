# envsubst (nginx image entrypoint) replaces ${PUBLIC_HOSTNAME} only.
# Keep nginx runtime variables as single-$ forms ($host, $remote_addr, …).

# Reject unknown Host / SNI before the named server block.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/nginx/certs/origin.pem;
    ssl_certificate_key /etc/nginx/certs/origin.key;
    ssl_client_certificate /etc/nginx/certs/authenticated_origin_pull_ca.pem;
    ssl_verify_client optional;

    return 444;
}

server {
    listen 80;
    server_name ${PUBLIC_HOSTNAME};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOSTNAME};

    ssl_certificate     /etc/nginx/certs/origin.pem;
    ssl_certificate_key /etc/nginx/certs/origin.key;
    ssl_client_certificate /etc/nginx/certs/authenticated_origin_pull_ca.pem;
    ssl_verify_client on;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Replace forwarding headers — never append client-supplied values.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_hide_header X-Powered-By;

    location /api/ {
        proxy_pass http://api:3000;
        proxy_buffering off;
        proxy_cache off;
        # Assistant SSE / long PDF responses.
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location / {
        proxy_pass http://web:8081;
    }
}
